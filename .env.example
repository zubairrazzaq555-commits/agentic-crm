# =============================================================================
# Agentic CRM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# NEVER commit the .env file — it is excluded by .gitignore.
# All values below are PLACEHOLDERS. Replace them with your actual keys.
# Missing optional keys will not prevent the application from starting.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
AGENTIC_CRM_LOG_LEVEL=INFO

# Environment: development, testing, production
AGENTIC_CRM_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite database file (relative or absolute)
# AGENTIC_CRM_DB_PATH=data/agentic_crm.db

# ---------------------------------------------------------------------------
# LLM Providers — Cloud (all optional, all free-tier)
# ---------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your-gemini-api-key-here

# Groq (https://console.groq.com/keys)
# GROQ_API_KEY=your-groq-api-key-here

# OpenRouter (https://openrouter.ai/keys) — free models only
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# HuggingFace Inference API (https://huggingface.co/settings/tokens)
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ---------------------------------------------------------------------------
# LLM Providers — Local
# ---------------------------------------------------------------------------
# Ollama base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Default local model to use via Ollama
# OLLAMA_DEFAULT_MODEL=phi3:mini

# ---------------------------------------------------------------------------
# Provider Policy
# ---------------------------------------------------------------------------
# Maximum retry attempts per provider call
# AGENTIC_CRM_MAX_RETRIES=3

# Strict no-paid-fallback policy (always enforced; shown for documentation)
# AGENTIC_CRM_ALLOW_PAID_APIS=false
